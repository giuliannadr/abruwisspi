{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abruwisspi",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // solo los videos pasan por el Worker (para responder por partes); el resto sale directo
    "run_worker_first": ["/video/*"]
  }
}
